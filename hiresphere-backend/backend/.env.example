# Django
DEBUG=True
SECRET_KEY=some-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=hiresphere
POSTGRES_USER=hiresphere
POSTGRES_PASSWORD=hiresphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary (file storage for resumes/avatars/logos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
FRONTEND_URL=http://localhost:5173

# Email (used for verification / password reset / notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HireSphere AI <noreply@hiresphere.ai>
